{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mailflare",
	"main": "./worker.ts",
	"compatibility_date": "2026-05-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "none",
	},
	"images": {
		"binding": "IMAGES",
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mailflare",
		},
	],
	"triggers": {
		"crons": ["0 2 * * *", "*/5 * * * *"],
	},
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60,
			},
		},
		{
			"name": "AGENT_RATE_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 120, "period": 60 },
		},
	],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true,
		},
	],
	"ai": { "binding": "AI" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mailflare",
			"migrations_dir": "drizzle/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "mailflare-raw",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "INBOUND_QUEUE",
				"queue": "mailflare-inbound",
			},
			{
				"binding": "OUTBOUND_QUEUE",
				"queue": "mailflare-outbound",
			},
			{
				"binding": "AGENT_QUEUE",
				"queue": "mailflare-agent",
			},
		],
		"consumers": [
			{
				"queue": "mailflare-inbound",
				"max_batch_size": 5,
				"max_retries": 3,
			},
			{
				"queue": "mailflare-outbound",
				"max_batch_size": 5,
				"max_retries": 3,
			},
			{
				"queue": "mailflare-agent",
				"max_batch_size": 1,
				"max_retries": 3,
			},
		],
	},
	// Worker Previews (non-production branch builds): previews do not inherit
	// top-level bindings, so each binding is re-declared here against
	// preview-safe resources. Queue consumers, cron triggers, and routes must
	// stay top level only. Create dedicated preview resources for your account
	// (`wrangler d1 create`, `wrangler r2 bucket create`, `wrangler queues create`),
	// then fill in their names/ids below. The preview D1 database is migrated
	// automatically during first-run setup.
	// See https://developers.cloudflare.com/workers/previews/configuration/
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "mailflare-preview",
				"database_id": "<PREVIEW_DATABASE_ID>",
			},
		],
		"r2_buckets": [
			{
				"binding": "BUCKET",
				"bucket_name": "mailflare-raw-preview",
			},
		],
		"send_email": [
			{
				"name": "EMAIL",
			},
		],
		"ai": { "binding": "AI" },
		"images": { "binding": "IMAGES" },
		"durable_objects": {
			"bindings": [
				{
					"name": "REALTIME",
					"class_name": "RealtimeHub",
				},
			],
		},
		"queues": {
			"producers": [
				{
					"binding": "INBOUND_QUEUE",
					"queue": "mailflare-inbound-preview",
				},
				{
					"binding": "OUTBOUND_QUEUE",
					"queue": "mailflare-outbound-preview",
				},
				{
					"binding": "AGENT_QUEUE",
					"queue": "mailflare-agent-preview",
				},
			],
		},
		"ratelimits": [
			{
				"name": "LOGIN_RATE_LIMIT",
				"namespace_id": "2001",
				"simple": {
					"limit": 20,
					"period": 60,
				},
			},
			{
				"name": "AGENT_RATE_LIMIT",
				"namespace_id": "2002",
				"simple": { "limit": 120, "period": 60 },
			},
		],
	},
}
